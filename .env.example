# Öffentliche Hauptdomain; lokal unverändert lassen.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Erst nach Prüfung von Rechtstexten und Betreiberangaben true setzen.
NEXT_PUBLIC_LAUNCH_READY=false
# Optional: Browser-Key, auf eigene Domains und Maps JavaScript / Places API (New) beschränken.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: eigener SERVER-Key für Routes API. Niemals NEXT_PUBLIC_ voranstellen!
GOOGLE_ROUTES_API_KEY=
# Original-Logo als public/logo-original.png ablegen, dann true setzen.
NEXT_PUBLIC_LOGO_READY=false
# Optional: verifizierten direkten Google-Unternehmensprofil-Link eintragen.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
