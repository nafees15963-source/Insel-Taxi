NEXT_PUBLIC_SITE_URL=https://inseltaxi-ratzeburg.de
# Optional. Ohne Schlüssel bleiben alle Formulare nutzbar.
# Google Maps JavaScript API und Places API aktivieren; HTTPS-Referrer einschränken.
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
# Optional: ausschließlich bestätigten Google-Unternehmensprofil-Link eintragen.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
# Für öffentliche Indexierung erst nach Prüfung der Rechtstexte auf true setzen.
NEXT_PUBLIC_LAUNCH_READY=false
